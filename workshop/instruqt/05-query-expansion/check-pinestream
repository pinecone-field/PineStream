#!/bin/bash
set -euo pipefail

echo "Testing the enhanced semantic search API with query expansion..."

# Temporarily disable exit on error to catch curl failures
set +e
SEARCH_RESPONSE=$(curl -s -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"description":"90s sci-fi movies","limit":5}' "http://localhost:3000/api/search/semantic")
HTTP_STATUS=$(echo "$SEARCH_RESPONSE" | tail -c 4)
SEARCH_BODY=$(echo "$SEARCH_RESPONSE" | head -c -4)
CURL_EXIT_CODE=$?
set -e

if [ $CURL_EXIT_CODE -ne 0 ]; then
    fail-message "Could not connect to enhanced semantic search API. Ensure the application is running."
    exit 1
fi

# Check HTTP status code
if [ "$HTTP_STATUS" != "200" ]; then
    fail-message "Enhanced semantic search API not responding. Ensure the application is running."
    exit 1
fi

if [ -z "$SEARCH_BODY" ]; then
    fail-message "Unexpected response structure. Did you make any changes outside the placeholders?"
    exit 1
fi

# Check if the response contains movies
if echo "$SEARCH_BODY" | grep -q '"movies"'; then
    echo "✅ Enhanced semantic search API is responding correctly"
else
    fail-message "Unexpected response structure. Did you make any changes outside the placeholders?"
    exit 1
fi

# Check if the response contains insights (AI-powered query expansion)
if echo "$SEARCH_BODY" | grep -q '"insight"'; then
    echo "✅ Query expansion insights are being generated"
else
    fail-message "Unexpected response structure. Did you make any changes outside the placeholders?"
    exit 1
fi

# Check if there are actual movies returned
echo "Checking if movies array contains results..."

# Find the movies line and check if it's empty
MOVIES_LINE=$(grep '"movies":' <<< "$SEARCH_BODY")

# Check if the array is empty using regex
if [[ "$MOVIES_LINE" =~ \[\s*\] ]]; then
    MOVIES_COUNT=0
    echo "Empty movies array detected"
else
    MOVIES_COUNT=1
    echo "Non-empty movies array detected"
fi

if [ "$MOVIES_COUNT" -gt 0 ]; then
    echo "✅ Enhanced semantic search API is returning movie results"
    echo "Found movies in search results"
else
    echo "⚠️  No movie results found in enhanced semantic search"    
    fail-message "It seems the query expansion may not be implemented. Please complete the challenge."
    exit 1
fi

# Check if insights contain AI-generated content
echo "Checking if insights contain AI-generated content..."

    # Simple check: if hasFilters is false, the feature isn't implemented
    if echo "$SEARCH_BODY" | grep -q '"hasFilters":\s*false'; then
        fail-message "It seems the query expansion may not be implemented. Please complete the challenge."
        exit 1
    fi

    # Check if the userMessage indicates the feature isn't available
    if echo "$SEARCH_BODY" | grep -q "Insight extraction is not available"; then
        fail-message "It seems the query expansion may not be implemented. Please complete the challenge."
        exit 1
    fi

echo "✅ Query expansion insights are being generated"

echo "🎉 Query expansion challenge check completed successfully!"
echo "The enhanced API is working and returning AI-powered insights."
exit 0
